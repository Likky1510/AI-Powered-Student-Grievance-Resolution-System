# ---------- Database ----------
DATABASE_URL=postgresql://grievance_user:grievance_pass@localhost:5432/grievance_db

# ---------- Auth ----------
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- Claude API ----------
# Get a real key from https://console.anthropic.com
# Leave as "mock" to run the app WITHOUT a real key (agents return canned responses)
ANTHROPIC_API_KEY=mock
CLAUDE_MODEL=claude-sonnet-4-6

# ---------- SendGrid (email notifications) ----------
# Leave as "mock" to skip real sending and just log emails to console
SENDGRID_API_KEY=mock
SENDGRID_FROM_EMAIL=noreply@yourcollege.edu

# ---------- Twilio (WhatsApp escalation alerts) ----------
# Leave as "mock" to skip real sending and just log messages to console
TWILIO_ACCOUNT_SID=mock
TWILIO_AUTH_TOKEN=mock
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ---------- App ----------
ENVIRONMENT=development
